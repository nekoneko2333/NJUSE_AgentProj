# 复制为 .env 后填写；请勿提交真实凭据。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 本机登录账号。示例密码仅供首次启动，请在 .env 中修改。
APP_USERNAME=moss
APP_PASSWORD=mosscode
APPROVAL_TIMEOUT_SECONDS=180

# Agent 默认只能操作该目录；留空时由 GUI 每次任务选择。
DEFAULT_WORKSPACE=

# 可选：默认保存在项目 data 目录，该目录不会提交到 Git。
# DATABASE_PATH=C:\path\to\mosscode.db
# CONTEXT_BUDGET_CHARS=12000
# CONTEXT_RECENT_TURNS=3
# CONTEXT_SUMMARY_CHARS=4000
